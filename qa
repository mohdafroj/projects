Find Prime Number 1 to 100:
n = 100
totalLoop = 0
totalPrime = 0
print("Prime Number: ")
if ( n > 2 ):
    totalPrime += 1
    print(2)
    for i in range(3,n,2):
        isPrime = True
        for j in range(3, int(i**0.5) + 1, 2):
            totalLoop += 1
            if(i%j == 0):
                isPrime = False
                break
        if (isPrime):
            totalPrime += 1
            print(i)
print("Total Loop: ", totalLoop)
print("Total Prime: ", totalPrime)
