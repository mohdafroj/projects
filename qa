Find Paires number in array where sum of number is given
arr = [5,4,2,6,3,1,9,7,8]
arr.sort()
sumOfNumber = 8
left = 0
right = len(arr) - 1
while (left < right):
    if ( arr[left] + arr[right] < sumOfNumber ):
        left += 1
    elif ( arr[left] + arr[right] > sumOfNumber ):
        right -= 1
    else:
        print(f'({arr[left]}, {arr[right]})')
        left += 1
        right -= 1

